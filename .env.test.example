# .env.test.example
# Find this in: Supabase Dashboard -> Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL="postgresql://postgres.TESTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Find this in: Supabase Dashboard -> Settings -> Database -> Connection string -> Direct connection
DIRECT_URL="postgresql://postgres:PASSWORD@db.TESTREF.supabase.co:5432/postgres"
# Find this in: Supabase Dashboard -> Settings -> API -> Project URL
SUPABASE_URL="https://TESTREF.supabase.co"
# Find this in: Supabase Dashboard -> Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY="replace-with-test-project-anon-key"
# Find this in: Supabase Dashboard -> Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="replace-with-test-project-service-role-key"
# Find this in: local test API configuration
PORT=3001
# Find this in: your test secret manager or generate with openssl rand -base64 48
JWT_SECRET="super-secret-at-least-32-chars-long"
# Find this in: your test secret manager or generate with openssl rand -base64 48
JWT_REFRESH_SECRET="super-secret-refresh-at-least-32-chars-long"
# Find this in: local auth token policy
JWT_EXPIRY="15m"
# Find this in: local auth token policy
JWT_REFRESH_EXPIRY="7d"
# Find this in: Docker compose test Redis service
REDIS_URL="redis://localhost:6379"
# Find this in: runtime environment selector
NODE_ENV="test"
# Find this in: Resend Dashboard -> API Keys
RESEND_API_KEY="re_test_key"
# Find this in: local frontend test configuration
FRONTEND_URL="http://localhost:3000"
# Find this in: test email delivery policy
RESEND_TEST_MODE=true
# Find this in: Pact Broker -> Settings -> API tokens
PACT_BROKER_URL="http://localhost:9292"
# Find this in: Pact Broker -> Settings -> API tokens
PACT_BROKER_TOKEN="replace-with-token-if-used"

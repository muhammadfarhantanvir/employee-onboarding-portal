{
  "name": "employee-onboarding-portal",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'",
    "test:unit": "jest --selectProjects unit",
    "test:smoke": "jest smoke --runInBand",
    "test:integration": "jest integration --runInBand",
    "test:contract": "jest contract --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:security:rbac": "jest security/rbac --runInBand",
    "test:security:tenants": "jest tenant-isolation --runInBand",
    "test:security:auth": "jest auth-boundary --runInBand",
    "test:security:input": "jest input-validation --runInBand",
    "test:security:zap": "bash tests/security/zap-baseline.sh",
    "test:mutation": "stryker run",
    "test:a11y": "jest a11y",
    "test:resilience": "jest resilience --runInBand",
    "test:regression": "jest regression --runInBand",
    "test:load": "k6 run --env SCENARIO=load tests/load/k6-master.js",
    "test:load:stress": "k6 run --env SCENARIO=stress tests/load/k6-master.js",
    "test:load:spike": "k6 run --env SCENARIO=spike tests/load/k6-master.js",
    "test:load:soak": "k6 run --env SCENARIO=soak tests/load/k6-master.js",
    "test:load:breakpoint": "k6 run --env SCENARIO=breakpoint tests/load/k6-master.js",
    "test:load:volume": "k6 run --env SCENARIO=volume tests/load/k6-master.js",
    "test:load:grafana": "k6 run --env SCENARIO=load --out influxdb=http://localhost:8086/k6 tests/load/k6-master.js",
    "test:all:fast": "npm run test && npm run test:smoke && npm run test:integration",
    "test:all:full": "npm run test:all:fast && npm run test:e2e && npm run test:security:rbac && npm run test:security:tenants",
    "db:reset:test": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/reset-test-db.ts",
    "db:seed:test": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.test.ts",
    "db:refresh:test": "npm run db:reset:test && npm run db:seed:test",
    "pact:consumer": "jest contract/consumer --runInBand",
    "pact:provider": "jest contract/provider --runInBand",
    "k6:run": "npm run test:load",
    "zap:baseline": "npm run test:security:zap",
    "stryker": "npm run test:mutation",
    "ci:tests": "npm run test:all:fast",
    "observability:dashboards": "node scripts/generate-observability-dashboards.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^10.4.22",
    "@pact-foundation/pact": "^16.4.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/supertest": "^6.0.3",
    "bullmq": "^5.66.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-mock-extended": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "@babel/core": "^7.29.0",
    "rxjs": "^7.8.2"
  }
}
